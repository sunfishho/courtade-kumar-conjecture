/-- Total natural-index accessor for the scaled nonnegative Bernstein input. -/
def topScaledCoeff (i j : Nat) : Nat :=
  (((topScaledData[i]?).getD #[])[j]?).getD 0

/-- Total natural-index accessor for the cached `z`-difference heads. -/
def zHeadCoeff (i b : Nat) : Int :=
  (((zHeadData[i]?).getD #[])[b]?).getD 0

/-- Total natural-index accessor for the scaled signed power coefficients. -/
def scaledPowerCoeff (a b : Nat) : Int :=
  (((scaledPowerData[a]?).getD #[])[b]?).getD 0

def adjacentDifferencesAux (left : Int) : List Int -> List Int
  | [] => []
  | right :: rest =>
      (right - left) :: adjacentDifferencesAux right rest

def adjacentDifferences : List Int -> List Int
  | [] => []
  | left :: rest => adjacentDifferencesAux left rest

def zRowCheckSteps (current expectedHeads : List Int) : Bool :=
  match expectedHeads, current with
  | [], remaining => remaining.all (fun value => decide (value = 0))
  | _ :: _, [] => false
  | expected :: rest, actual :: currentRest =>
      decide (actual = expected) &&
        zRowCheckSteps (adjacentDifferencesAux actual currentRest) rest

def zRowCheck (i : Nat) : Bool :=
  let scaledRow := (List.range 61).map (fun j => Int.ofNat (topScaledCoeff i j))
  let expectedHeads := (List.range 23).map (fun b => zHeadCoeff i b)
  zRowCheckSteps scaledRow expectedHeads

def zAllRowsCheck : Bool :=
  (List.range 48).all zRowCheck

def zHeadColumn (b : Nat) : List Int :=
  (List.range 48).map (fun i => zHeadCoeff i b)

def scaledPowerColumn (b : Nat) : List Int :=
  (List.range 48).map (fun a => scaledPowerCoeff a b)

def cColumnCheckSteps (b a : Nat) (current expected : List Int) : Bool :=
  match expected, current with
  | [], _ => true
  | _ :: _, [] => false
  | target :: rest, actual :: currentRest =>
      decide (
        (Nat.choose 47 a : Int) * (Nat.choose 60 b : Int) * actual = target) &&
        cColumnCheckSteps b (a + 1) (adjacentDifferencesAux actual currentRest) rest

def cColumnCheck (b : Nat) : Bool :=
  cColumnCheckSteps b 0 (zHeadColumn b) (scaledPowerColumn b)

def cAllColumnsCheck : Bool :=
  (List.range 23).all cColumnCheck

#kernel_checked_bool zDifferenceCache_reduction zAllRowsCheck
#kernel_checked_bool cDifferencePower_reduction cAllColumnsCheck

end CourtadeKumar.TopBernsteinFiniteDifferenceData
